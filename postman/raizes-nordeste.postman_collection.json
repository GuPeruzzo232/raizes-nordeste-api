    {
      "name": "03 Pedidos multicanal",
      "item": [
        {
          "name": "Pedido pelo APP (cliente)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tkMaria}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "postman-{{$timestamp}}"
              }
            ],
            "url": "{{baseUrl}}/api/pedidos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"unidadeId\": 1,\n  \"canal\": \"APP\",\n  \"itens\": [\n    {\n      \"produtoId\": 2,\n      \"quantidade\": 2\n    },\n    {\n      \"produtoId\": 5,\n      \"quantidade\": 1\n    }\n  ]\n}"
            }
