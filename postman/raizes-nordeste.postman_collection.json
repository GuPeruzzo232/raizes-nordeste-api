          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const p = pm.response.json();",
                  "pm.test(\"Canal APP gravado\", () => pm.expect(p.canal).to.eql(\"APP\"));",
                  "pm.test(\"Total 38.00 pelo cardápio\", () => pm.expect(p.total).to.eql(38.00));",
                  "pm.collectionVariables.set(\"pedidoId\", p.id);"
