    {
      "name": "04 Pagamento externo",
      "item": [
        {
          "name": "Solicitar pagamento PIX",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tkMaria}}"
              }
            ],
            "url": "{{baseUrl}}/api/pedidos/{{pedidoId}}/pagamentos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"metodo\": \"PIX\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const pg = pm.response.json();",
                  "pm.test(\"Aprovado e pedido PAGO\", () => { pm.expect(pg.status).to.eql(\"APROVADO\"); pm.expect(pg.statusPedido).to.eql(\"PAGO\"); });",
                  "pm.collectionVariables.set(\"pagamentoId\", pg.id);",
                  "pm.collectionVariables.set(\"transacao\", pg.transacaoExterna);"
                ]
              }
            }
          ]
        },
        {
          "name": "Pagar pedido já pago (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tkMaria}}"
              }
            ],
            "url": "{{baseUrl}}/api/pedidos/{{pedidoId}}/pagamentos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"metodo\": \"PIX\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 409\", () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Webhook do provedor (1ª vez)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Webhook-Secret",
                "value": "segredo-webhook-dev"
              }
            ],
            "url": "{{baseUrl}}/api/pagamentos/webhook",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventoId\": \"evt-estorno-{{pagamentoId}}\",\n  \"pagamentoId\": {{pagamentoId}},\n  \"transacaoExterna\": \"{{transacao}}\",\n  \"status\": \"ESTORNADO\",\n  \"mensagem\": \"Chargeback\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Processado\", () => pm.expect(pm.response.json().processado).to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "Webhook repetido (ignorado)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Webhook-Secret",
                "value": "segredo-webhook-dev"
              }
            ],
            "url": "{{baseUrl}}/api/pagamentos/webhook",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventoId\": \"evt-estorno-{{pagamentoId}}\",\n  \"pagamentoId\": {{pagamentoId}},\n  \"transacaoExterna\": \"{{transacao}}\",\n  \"status\": \"ESTORNADO\",\n  \"mensagem\": \"Chargeback\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Duplicado não reprocessa\", () => pm.expect(pm.response.json().processado).to.be.false);"
                ]
              }
            }
          ]
        },
        {
          "name": "Webhook sem segredo (401)",
          "request": {
            "method": "POST",
