classDiagram
direction TB
class Unidade {
  +Long id
  +String nome
  +String cidade
  +String uf
  +boolean ativa
}
class Produto {
  +Long id
  +String nome
  +String categoria
  +BigDecimal precoBase
  +boolean sazonal
  +boolean ativo
}
class ItemCardapio {
  +BigDecimal preco
  +boolean disponivel
  +LocalDate inicioVigencia
  +LocalDate fimVigencia
  +vigenteEm(LocalDate) boolean
}
class Estoque {
  +int quantidade
  +Instant atualizadoEm
  +definirQuantidade(int)
}
class Usuario {
  +Long id
  +String nome
  +String email
  +String senhaHash
  +Perfil perfil
  +String cpf
  +boolean anonimizado
  +anonimizar(String)
}
class Consentimento {
  +FinalidadeConsentimento finalidade
  +boolean concedido
  +String versaoTermo
  +Instant registradoEm
}
class ContaFidelidade {
  +int pontos
  +creditar(int)
}
class Pedido {
  +Long id
  +CanalPedido canal
  +StatusPedido status
  +BigDecimal subtotal
  +BigDecimal desconto
  +BigDecimal total
  +String idempotencyKey
  +Long versao
  +adicionarItem(Produto, int, BigDecimal)
  +aplicarDesconto(BigDecimal)
  +alterarStatus(StatusPedido)
  +cancelar(String)
}
class ItemPedido {
  +int quantidade
  +BigDecimal precoUnitario
  +BigDecimal subtotal
}
class Pagamento {
  +BigDecimal valor
  +MetodoPagamento metodo
  +StatusPagamento status
  +String transacaoExterna
  +String idempotencyKey
  +int tentativas
