}
class EventoPagamentoRecebido {
  +String eventoId
  +String statusRecebido
}
class RegistroAuditoria {
  +Long usuarioId
  +String perfil
  +Long unidadeId
  +String acao
  +String entidade
  +Long entidadeId
  +String detalhes
  +String ip
  +Instant dataHora
}
class CanalPedido {
  <<enumeration>>
  APP
  TOTEM
  BALCAO
  PICKUP
  WEB
}
class StatusPedido {
  <<enumeration>>
  AGUARDANDO_PAGAMENTO
  PAGO
  EM_PREPARO
  PRONTO
  ENTREGUE
  CANCELADO
}
class Perfil {
  <<enumeration>>
  CLIENTE
  ATENDENTE
  COZINHA
  GERENTE
  MATRIZ
}
Unidade "1" --> "*" ItemCardapio
Produto "1" --> "*" ItemCardapio
Unidade "1" --> "*" Estoque
Produto "1" --> "*" Estoque
Unidade "0..1" <-- "*" Usuario : lotado em
Usuario "1" --> "*" Consentimento
Usuario "1" --> "0..1" ContaFidelidade
Unidade "1" <-- "*" Pedido
Usuario "0..1" <-- "*" Pedido : cliente
Pedido "1" *-- "1..*" ItemPedido
ItemPedido "*" --> "1" Produto
Pedido "1" --> "*" Pagamento
Pagamento "1" --> "*" EventoPagamentoRecebido
Pedido ..> CanalPedido
Pedido ..> StatusPedido
Usuario ..> Perfil
Pedido <.. RegistroAuditoria : rastreia
